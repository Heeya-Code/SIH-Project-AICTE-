# Copy to server/.env (or export in your shell). No real secrets belong in this file.
PORT=4000
DB_PATH=./data/approvalflow.db
STORAGE_DIR=./data/storage          # private file storage; never served statically
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=8h
JOB_INTERVAL_SECONDS=300            # server-side deadline scheduler
MAX_UPLOAD_MB=5
ALLOW_DEMO_TOOLS=true               # simulated clock + reset. MUST be false in any real deployment
DEMO_PASSWORD=Demo@1234             # only used when seeding synthetic users
# TRUST_PROXY=1                     # set when behind a reverse proxy
